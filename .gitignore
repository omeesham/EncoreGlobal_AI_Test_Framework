# Build artifacts
node_modules/
reports/*
!reports/bugs/
# Crawler bug reports ship (json/md/html); their full-page screenshots do not — binary churn,
# one set per run, and the reports still reference them for whoever runs the crawl locally.
reports/bugs/crawler/evidence/
logs/
test-results/
test-results-*/
playwright-report/
playwright/.cache/
*.tsbuildinfo

# Test evidence runtime artifacts (field-case-runner rejected inputs, etc.)
.test-evidence/


# Secrets & local overrides — never commit (credentials, API keys)
.env.local
.env.*.local
.env.server

# Live session state — contains auth cookies, never commit
.auth/
.playwright-cli/
.playwright-mcp/

# Runtime state
.claude/state/
.testrail/

# Agent-internal scratch
scripts/walks/

# OS / IDE
.DS_Store
Thumbs.db
~$*
.idea/
.vscode/

# Merged/renamed report output
playwright-report-*/
blob-report/
blob-report-*/

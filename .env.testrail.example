# Copy into .env.local (dotenv-flow loads it) or set as CI env vars.
# No secrets here — never commit the real API key.

# Master switch — the reporter is completely inert unless this is "true".
TESTRAIL_ENABLED=true

# Connection — API key from TestRail: My Settings > API Keys.
TESTRAIL_HOST=https://encore.testrail.net
TESTRAIL_USERNAME=your.name@company.com
TESTRAIL_API_KEY=paste-your-api-key-here

# Where results land — Encore "Micro Services E2E Automation" is project 8, suite 1620.
# Project id is the number in index.php?/projects/overview/<ID>.
TESTRAIL_PROJECT_ID=8
TESTRAIL_SUITE_ID=1620

# Sprint roll-up: create a Milestone per sprint and point this at the current
# one (id from index.php?/milestones/view/<ID>); every run then reports under it.
#TESTRAIL_MILESTONE_ID=3

# Optional behavior tweaks.
# Post into one fixed existing run instead of creating a new run per execution:
#TESTRAIL_RUN_ID=2165
# Custom run name (default: "Playwright - <env> - <timestamp>"):
#TESTRAIL_RUN_NAME=Sprint 16 nightly regression
# Close the run after posting results:
#TESTRAIL_CLOSE_RUN=false

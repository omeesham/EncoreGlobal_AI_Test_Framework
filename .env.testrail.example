# TestRail integration — copy these lines into .env.local (created next to this
# file; dotenv-flow loads it automatically for local runs) or set them as CI
# environment variables. This example file contains no secrets — never commit
# the real API key.

# Master switch — the reporter is completely inert unless this is "true".
TESTRAIL_ENABLED=true

# Connection — see README "TestRail integration" for how to obtain each value.
TESTRAIL_HOST=https://encore.testrail.net
TESTRAIL_USERNAME=your.name@company.com
TESTRAIL_API_KEY=paste-your-api-key-here

# Where results land. Project id is the number in the TestRail URL when the
# project is open: index.php?/projects/overview/<ID>
TESTRAIL_PROJECT_ID=1

# Only needed when the project uses multiple test suites
# (id from index.php?/suites/view/<ID>):
#TESTRAIL_SUITE_ID=2

# Sprint roll-up: create a Milestone per sprint in TestRail and point this at
# the current one (id from index.php?/milestones/view/<ID>). Update at sprint
# start; every run then reports under that sprint.
#TESTRAIL_MILESTONE_ID=3

# Optional behavior tweaks.
# Post into one fixed existing run instead of creating a new run per execution:
#TESTRAIL_RUN_ID=123
# Custom run name (default: "Playwright — <env> — <timestamp>"):
#TESTRAIL_RUN_NAME=Sprint 14 nightly regression
# Close the run after posting results:
#TESTRAIL_CLOSE_RUN=false

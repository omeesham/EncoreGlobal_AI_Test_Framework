# TestRail integration — copy the block you need into .env.local (dotenv-flow
# picks it up automatically) or set the same names as CI environment variables.
# The reporter is inert until TESTRAIL_ENABLED=true.

# ---- connection (required) ----
TESTRAIL_ENABLED=true
TESTRAIL_HOST=https://encore.testrail.net
TESTRAIL_USERNAME=you@company.com
# TestRail -> My Settings -> API Keys
TESTRAIL_API_KEY=
TESTRAIL_PROJECT_ID=8
TESTRAIL_SUITE_ID=1620

# ---- the shared run (all optional) ----
# Results accumulate into ONE run per execution session: the first push creates
# it and records it in .testrail/current-run.json, every later push widens that
# run's case list and reports into it. Run name convention:
#
#   MFE-E2E-Regression-Testing — 2026-09-09 21:11 (local)
#
# Nothing below needs setting for the local workflow to work.

# Pin every push to one existing run; bypasses the session file entirely.
# This is what the GitHub Actions workflow sets on each test job.
# TESTRAIL_RUN_ID=2165

# Replace the generated run name wholesale.
# TESTRAIL_RUN_NAME=

# Session identity — a change starts a new run. Defaults to the CI workflow run
# id when on CI, otherwise "local".
# TESTRAIL_RUN_KEY=

# The "(local)" tag at the end of the run name. Defaults to the detected
# environment: local / e2e / github-actions.
# TESTRAIL_RUN_ENV=local

# How long a local session keeps reusing the same run (default 12).
# `npm run testrail:run:reset` starts a new one immediately.
# TESTRAIL_RUN_TTL_HOURS=12

# Attach the run to a milestone.
# TESTRAIL_MILESTONE_ID=

# Close the run after every push. Leave unset for the module-by-module
# workflow — closing it means the next module opens a new run.
# TESTRAIL_CLOSE_RUN=true

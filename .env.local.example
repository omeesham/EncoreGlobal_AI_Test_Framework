# Local run config (git-ignored). Loaded by dotenv-flow for bare `npm test` / `npx playwright test`.
# Same target server as CI (.env.e2e), but CI_ENV must NOT be 'e2e' locally — the env-guard
# in src/setup/global-setup.ts blocks that. Use 'local'.

# Environment (must be present for pre-flight, must not be 'e2e' locally)
CI_ENV=local

# Multi-tenant: active client tree under clients/<id>/.
ACTIVE_CLIENT=encore

# Application URLs (Navigator Cloud — Encore's single e2e server)
BASE_URL=
HOME_URL=
API_BASE_URL=

# Timeouts (generous for local debugging)
TIMEOUT_DEFAULT=60000
TIMEOUT_NAVIGATION=90000
TIMEOUT_ACTION=30000
TIMEOUT_ASSERTION=10000

# Test Credentials (Navigator Cloud — Microsoft SSO automation user)
NAVIGATOR_USERNAME=
NAVIGATOR_PASSWORD=

# Feature Flags
ENABLE_TRACING=true
ENABLE_VIDEO=true
ENABLE_SCREENSHOTS=true
ENABLE_API_MOCKING=false

# Retry Configuration (no retries locally for faster feedback)
RETRY_COUNT=0
MAX_FAILURES=999

# Browser Configuration
DEFAULT_BROWSER=chrome
HEADLESS=false

# Logging
LOG_LEVEL=debug
LOG_FILE=logs/test-execution.log

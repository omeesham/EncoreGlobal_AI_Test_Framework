# Encore build-server config — used ONLY when the tests run on a build server
# (GitHub Actions, Jenkins, Azure DevOps, ...). Do NOT use this file on your own
# machine; a local run that points at it is blocked on purpose.
#
# Running on your own machine? Open `.env.local`, fill in the two blanks, then
# `npm test`. See README.md, "Quickstart".
#
# No passwords here. The build server supplies NAVIGATOR_USERNAME and
# NAVIGATOR_PASSWORD from its own secret store. See README.md, "Running it on
# GitHub Actions".
#
# Retries (2 on the build server) live in playwright.config.ts. Tests run one at a
# time by default everywhere — override per run with MAX_WORKERS.
#
# On a build server, values in this file win over anything in .env.local.
# Locally, this file is not read at all — .env.local supplies everything.

CI_ENV=e2e
ACTIVE_CLIENT=encore

# Target server (Navigator Cloud — Encore's single e2e environment)
BASE_URL=https://cloudapps-e2e.encoreglobal.com/navigator/
HOME_URL=https://cloudapps-e2e.encoreglobal.com/navigator/locations/1604/home
API_BASE_URL=https://cloudapps-e2e.encoreglobal.com/navigator/api/v1

# Failure artifacts
ENABLE_TRACING=true
ENABLE_VIDEO=true
ENABLE_SCREENSHOTS=true

# Misc
DEFAULT_BROWSER=chrome
LOG_LEVEL=info

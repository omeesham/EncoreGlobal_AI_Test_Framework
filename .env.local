# =============================================================================
# E2E ENVIRONMENT CONFIGURATION
# =============================================================================
# Encore Navigator Cloud has a single environment: e2e.
# For local overrides, create .env.e2e.local (not tracked by Git).
# In CI, GitHub Actions secrets override BASE_URL / NAVIGATOR_* via the
# workflow's `env:` block; this file provides defaults for local runs.
# =============================================================================
 
# Environment
 
# Multi-tenant: active client tree under clients/<id>/.
ACTIVE_CLIENT=encore
 
# Application URLs (Navigator Cloud)
BASE_URL=https://cloudapps-e2e.encoreglobal.com/navigator/
HOME_URL=https://cloudapps-e2e.encoreglobal.com/navigator/locations/1604/home
API_BASE_URL=https://cloudapps-e2e.encoreglobal.com/navigator/api/v1
 
# Timeouts (generous for local debugging)
TIMEOUT_DEFAULT=60000
TIMEOUT_NAVIGATION=90000
TIMEOUT_ACTION=30000
TIMEOUT_ASSERTION=10000
 
# Test Credentials (Navigator Cloud — Microsoft SSO automation user)
NAVIGATOR_USERNAME=s-prd-clickauto@psav.com
NAVIGATOR_PASSWORD=6p8zA`96F>!0
 
# Feature Flags
ENABLE_TRACING=true
ENABLE_VIDEO=true
ENABLE_SCREENSHOTS=true
ENABLE_API_MOCKING=false
 
# Retry Configuration (no retries locally for faster feedback)
RETRY_COUNT=0
MAX_FAILURES=999

# Parallelism — override per run with MAX_WORKERS=N or --workers=N.
MAX_WORKERS=4
 
# Browser Configuration
DEFAULT_BROWSER=chrome
HEADLESS=false
 
# Logging
LOG_LEVEL=debug
LOG_FILE=logs/test-execution.log

# TestRail Integration (encore.testrail.net)
# Results push to the run below after each execution. Set TESTRAIL_ENABLED=false
# to run without pushing. Generate the API key in TestRail: My Settings > API Keys.
TESTRAIL_ENABLED=true
TESTRAIL_HOST=https://encore.testrail.net
TESTRAIL_USERNAME=omeesha.mahanta@jade-biz.com
TESTRAIL_API_KEY=xNiDVLGlX84/ryRIqCAb-0uAxVh0aXbnctmoJt0gP
# Testrail API key name: "qa-automation"
# Each execution auto-creates a fresh dated run ("Playwright YYYY-MM-DD HH:MM (local)")
# in the project/suite below, containing exactly the cases that ran.
# Micro Services E2E Automation (P8) / Suite S1620.
TESTRAIL_PROJECT_ID=8
TESTRAIL_SUITE_ID=1620
# To push into ONE fixed existing run instead (old behavior), set its ID here —
# when set, it wins over auto-create. e.g. R2165 -> 2165
# TESTRAIL_RUN_ID=2165

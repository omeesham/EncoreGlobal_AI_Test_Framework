# ============================================================================
#  LOCAL RUN SETUP — fill in two values, then run. Takes about a minute.
#
#  STEP 1 — fill in the two blanks in section 1 below.
#  STEP 2 — run:  npm test
#
#  That is the whole setup. Nothing else in this folder needs editing.
#  Do NOT touch ".env.e2e" — that file is only used on a build server.
#
#  Your password goes in this file. After you fill it in, run this once so
#  git stops watching it and you never commit your password by accident:
#      git update-index --skip-worktree .env.local
# ============================================================================


# ---- 1. FILL THESE IN ------------------------------------------------------
# The Navigator sign-in the tests use. Ask the QA automation team for it.
# Use a dedicated test account, not your personal one, and use an account with
# NO authenticator-app prompt — the tests cannot type a 6-digit code.

NAVIGATOR_USERNAME=
NAVIGATOR_PASSWORD=


# ---- 2. LEAVE THESE ALONE --------------------------------------------------
# Already pointed at the correct test server. Change only if you were told to.

BASE_URL=https://cloudapps-e2e.encoreglobal.com/navigator/
HOME_URL=https://cloudapps-e2e.encoreglobal.com/navigator/locations/1604/home


# ---- 3. OPTIONAL — only touch these if you know why ------------------------

# How many tests run at the same time. Default is 1.
# Higher is faster, but tests then edit the same office at the same time and
# fail for the wrong reason. Leave it commented out unless you accept that.
# MAX_WORKERS=1

# Detail level written to logs/test-execution.log: debug | info | warn | error
LOG_LEVEL=info

# Keep the video, screenshot and trace of every failure. These are what
# `npm run share-for-debugging` packages up for the QA automation team.
# Turning any of them off makes a failure much harder to diagnose.
ENABLE_TRACING=true
ENABLE_VIDEO=true
ENABLE_SCREENSHOTS=true

# Browser used for local runs. `npx playwright install chromium` installs this one.
DEFAULT_BROWSER=chrome
